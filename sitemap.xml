---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url | xml_escape }}</loc>
  </url>
{% assign resources = site.resources | sort: "url" %}
{% for resource in resources %}
  <url>
    <loc>{{ resource.url | absolute_url | xml_escape }}</loc>
{% if resource.last_updated %}
    <lastmod>{{ resource.last_updated | date: "%Y-%m-%d" }}</lastmod>
{% endif %}
  </url>
{% endfor %}
</urlset>
